# Neon — PostgreSQL připojení
DATABASE_URL=postgresql://...

# NextAuth
NEXTAUTH_SECRET=                  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Veřejná URL aplikace — používá se v klientských linkech (/p/token)
# Nastav na hlavní produkční host (D1, R-075): https://www.zakaziq.cz
NEXT_PUBLIC_APP_URL=https://www.zakaziq.cz

# Admin přihlášení
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=              # node -e "require('bcryptjs').hash('heslo',12).then(console.log)"

# Gmail SMTP — emailová brána (nodemailer). Záložní účet pro případ, že není
# vyplněná dvojice VIZEON_GMAIL_* níž.
GMAIL_USER=tvuj@gmail.com
GMAIL_APP_PASSWORD=                # App password z Google Account → Security → App passwords

# Odesílací schránka a cíl pro admin oznámení. Po sloučení byznysů (AD02)
# odchází z téhle adresy VŠECHNA pošta adminu — i poptávky z alteno.cz
# a prvotka.cz. Bez vyplněné dvojice user+pass se použije GMAIL_USER/ADMIN_EMAIL.
VIZEON_GMAIL_USER=info@vizeon.cz
VIZEON_GMAIL_APP_PASSWORD=         # App password pro info@vizeon.cz (Google Account → Security → App passwords)
VIZEON_ADMIN_EMAIL=info@vizeon.cz  # Kam chodí admin notifikace pro VIZEON zakázky/konzultace/hodnocení/leady

# Resend — jen hromadné launch emaily na waitlist ve Hub › Byznys › Startup
# (sendLaunchEmailBlast). Zbytek appky posílá přes Gmail SMTP výše.
RESEND_API_KEY=                    # API klíč z resend.com

# Kontakt admin (pro WhatsApp a hovorové konzultace)
ADMIN_PHONE=420601234567          # Bez mezery, bez +

# Meeting linky (vyplň pevné linky pro Teams/Meet místnosti)
GOOGLE_MEET_LINK=https://meet.google.com/xxx-yyyy-zzz
TEAMS_MEETING_LINK=https://teams.microsoft.com/l/meetup-join/...

# Veřejný booking API (app/api/public/booking) — pro integraci s vizeon.cz
VIZEON_API_KEY=                   # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Veřejný booking API (app/api/public/booking/alteno) — pro integraci s alteno.cz
ALTENO_API_KEY=                   # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Veřejný leads API (app/api/public/leads) — pro integraci s n8n chatbotem
N8N_API_KEY=                      # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Veřejný alteno-leads API (app/api/public/alteno-leads) — příjem leadů z
# kontaktního formuláře na alteno.cz. Posílá se jako hlavička
# x-alteno-lead-signature. Vlastní dedikovaný klíč, nesdílet s ALTENO_API_KEY.
ALTENO_LEAD_WEBHOOK_SECRET=       # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Veřejný prvotka-leads API (app/api/public/prvotka-leads) — příjem leadů
# z kontaktního formuláře na prvotka.cz. Hlavička x-prvotka-lead-signature.
# Vlastní klíč: kdyby unikl z repa Prvotky, nesmí pustit poptávky za ostatní
# weby. Napojení webu je práce v jeho repozitáři (AD02).
PRVOTKA_LEAD_WEBHOOK_SECRET=      # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Veřejný agent-leads API (app/api/public/agent-leads) — pro integraci s
# vizeon-lead-agent (Python/FastAPI). Stejná hodnota musí být v repu
# vizeon-lead-agent nastavená jako ZAKAZIQ_API_KEY.
VIZEON_AGENT_API_KEY=              # python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Veřejný invoices API (app/api/public/invoices) — zakládání faktur zvenčí
# (n8n: přeposlaný e-mail s fakturou, export z fakturačního nástroje).
# Posílá se jako Authorization: Bearer <klíč>.
INVOICES_API_KEY=                 # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Cron zabezpečení — Vercel posílá tento token v Authorization hlavičce při spuštění cron jobu
CRON_SECRET=                      # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Cesta k lokálnímu Chrome (Puppeteer v dev prostředí bez @sparticuz/chromium —
# generování PDF faktur)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# AI Asistenti (Startup sekce) + AI přepis faktur (app/api/invoices/parse).
# Bez klíče se faktury pořád zadávají ručně, jen se nenabídne „Načíst z PDF".
ANTHROPIC_API_KEY=                 # API klíč z console.anthropic.com
OPENAI_API_KEY=                    # přepis hlasu klientů na portálu /p (bez klíče je mikrofon skrytý)
OPENAI_TRANSCRIBE_MODEL=           # volitelně, výchozí gpt-4o-transcribe
CLIENT_REQUEST_AI_MODEL=           # volitelně, model pro shrnutí požadavků klientů (výchozí = ADMIN_AI_MODEL_SMART)
ADMIN_AI_MODEL_FAST=               # volitelně, věta → návrh akce a krátká odpověď asistenta (výchozí claude-haiku-5-5)
ADMIN_AI_MODEL_SMART=              # volitelně, nejednoznačná věta a práce s pamětí (výchozí claude-sonnet-5-5)
ADMIN_AI_MODEL_VISION=             # volitelně, čtení PDF faktury (výchozí claude-haiku-5-5)

# --- ZakazIQ Workspace ---
# SaaS pro firmy (/w/*, /api/ws/*, /api/public/v1/*). Admin konzole tyto proměnné nepoužívá.
# Sdílené s adminem a už definované výše: NEXT_PUBLIC_APP_URL (veřejná adresa appky
# pro odkazy v e-mailech a widgetu), RESEND_API_KEY (Workspace posílá všechny e-maily
# přes Resend), CRON_SECRET (stejný token pro crony Workspace).
DATABASE_URL_WS=                   # Neon connection string role ws_app (jen schéma ws, pod RLS) — zapíše node scripts/ws-create-role.js, nikdy nezakládat v Neon konzoli
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # Clerk — veřejný klíč (pk_…) pro přihlášení firem
CLERK_SECRET_KEY=                  # Clerk — tajný klíč (sk_…), jen na serveru
CLERK_WEBHOOK_SECRET=              # Clerk — podpisový klíč webhooku /api/clerk/webhook (whsec_…)
STRIPE_SECRET_KEY=                 # Stripe — omezený klíč (rk_…) pro Checkout, Customer Portal a doklady; práva v docs/workspace/SETUP.md → Stripe
STRIPE_WEBHOOK_SECRET=             # Stripe — podpisový klíč webhooku /api/stripe/webhook (whsec_…)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # Stripe — veřejný klíč (pk_…); kód ho zatím nepotřebuje (Checkout je přesměrování)
STRIPE_PRICE_MONTHLY=              # Stripe — ID měsíční ceny tarifu 249 Kč (price_…)
WS_KEY_PEPPER=                     # Tajný pepř pro hash API klíčů webů klientů a podpis odkazů v e-mailech — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_KEY_PEPPER=                  # Tajný pepř pro hash klíčů projektů (hlášení z Claude Code, KP04), min. 32 znaků, samostatný od WS_KEY_PEPPER — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_INVITE_PEPPER=             # Tajný pepř pro hash pozvánek do klientského prostoru (KP05), min. 32 znaků — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL_PORTAL=              # Role portal_app (klientský prostor) — zapíše scripts/portal-create-role.js po migracích 093–096
WS_EMAIL_FROM=                     # Odesílací adresa e-mailů Workspace na ověřené doméně v Resendu (např. rezervace@zakaziq.cz). Bez ní e-maily čekají ve frontě a nic neodchází
RESEND_WEBHOOK_SECRET=             # Resend — podpisový klíč webhooku /api/resend/webhook (whsec_…), nedoručené e-maily; bez něj 503
