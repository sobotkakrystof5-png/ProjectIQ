# next-auth 4 declares nodemailer as an optional peer for EmailProvider.
# This app uses CredentialsProvider; mail is sent directly by lib/email.ts.
legacy-peer-deps=true

# Supply-chain ochrana: nainstaluj jen balíčky starší 7 dní (npm 11.10+; starší npm klíč ignoruje).
# Naléhavou záplatu jde vynutit jednorázově přepínačem příkazu npm install.
min-release-age = 7
