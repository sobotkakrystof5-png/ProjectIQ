# legacy-peer-deps zbylo z doby next-auth (nodemailer jako peer). Jestli je ještě potřeba, neověřeno.
legacy-peer-deps=true

# Supply-chain ochrana: nainstaluj jen balíčky starší 7 dní (npm 11.10+; starší npm klíč ignoruje).
# Naléhavou záplatu jde vynutit jednorázově přepínačem příkazu npm install.
min-release-age = 7
